# ============================================
# Fractal - Open Source Repository
# ============================================

# ========================
# Frontend
# ========================
# Frontend source lives in the private Fractal-Vue repo. The published
# `ghcr.io/<owner>/fractal-frontend` image is consumed via docker-compose
# by default. For local source iteration, clone Fractal-Vue into the
# `/Fractal-Vue/` slot below and run `docker compose up --build` — that
# path is referenced by docker-compose.yml's frontend `build.context`
# directive. Nothing under these paths should ever be committed here.
/fractal_vue/
/Fractal-Vue-src/
/Fractal-Vue/
/frontend/

# ========================
# Environment & Secrets
# ========================
.env
.env.local
.env.*.local
backend_api_python/.env

# ========================
# IDE & OS
# ========================
.idea/
.vscode/
agent-tools/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.iml

