# Fractal Docker Compose overrides
# Frontend: build from local source instead of pulling prebuilt GHCR image.
# After first GitHub Actions publish succeeds, you can remove COMPOSE_FILE
# and it will pull from ghcr.io/doonyjr/fractal-frontend automatically.
FRONTEND_IMAGE=ghcr.io/doonyjr/fractal-frontend
COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
# IMAGE_TAG=latest
